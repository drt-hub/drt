{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/drt-hub/drt/blob/main/benchmarks/result-schema.json",
  "title": "drt sync benchmark result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scenario",
    "row_count",
    "git_commit",
    "timestamp",
    "measurements"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "scenario": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "row_count": { "type": "integer", "minimum": 1 },
    "git_commit": {
      "type": "string",
      "pattern": "^([0-9a-f]{40}|unknown)$"
    },
    "timestamp": { "type": "string", "format": "date-time" },
    "measurements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "duration_seconds",
        "rows_per_second",
        "peak_memory_bytes",
        "destination_call_count"
      ],
      "properties": {
        "duration_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "rows_per_second": { "type": "number", "exclusiveMinimum": 0 },
        "peak_memory_bytes": { "type": "integer", "minimum": 0 },
        "destination_call_count": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
