{
  "$defs": {
    "HistoryConfig": {
      "description": "Sync execution history retention (#276).\n\nLocal history keeps every entry inside ``retention_days``. Remote object\nstores additionally retain only the newest ``max_entries`` per sync, which\nbounds the object downloaded and rewritten by each conditional update.",
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "retention_days": {
          "default": 30,
          "title": "Retention Days",
          "type": "integer"
        },
        "max_entries": {
          "default": 500,
          "minimum": 1,
          "title": "Max Entries",
          "type": "integer"
        }
      },
      "title": "HistoryConfig",
      "type": "object"
    },
    "QueryTaggingConfig": {
      "description": "Cost-attribution tagging on extract/destination queries (#768).\n\nOn by default (dbt's ``query_comment`` precedent): a query with no tag at\nall is the thing that made per-sync warehouse cost attribution impossible\nin the first place (see #710/#738's smoke-account digest, which had to\nfall back to account-level spend). ``extra`` is merged into every tag\npayload alongside drt's own ``app``/``sync``/``run_id`` \u2014 e.g.\n``{\"team\": \"growth\"}`` to carry a cost-center through to\n``INFORMATION_SCHEMA.JOBS`` / ``QUERY_HISTORY`` queries.",
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "extra": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Extra",
          "type": "object"
        }
      },
      "title": "QueryTaggingConfig",
      "type": "object"
    },
    "SourceConfig": {
      "properties": {
        "type": {
          "enum": [
            "bigquery",
            "snowflake",
            "postgres",
            "duckdb",
            "clickhouse"
          ],
          "title": "Type",
          "type": "string"
        },
        "project": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Project"
        },
        "dataset": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dataset"
        },
        "credentials": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Credentials"
        }
      },
      "required": [
        "type"
      ],
      "title": "SourceConfig",
      "type": "object"
    },
    "StateConfig": {
      "description": "State-backend selection and backend-specific settings (#756).\n\nThis mirrors :class:`~drt.config.sync_options.WatermarkConfig`'s shape:\none discriminating backend field plus optional fields validated against\nthat choice. GCS and S3 use ``bucket`` plus an optional object-key\n``prefix``. S3's authentication and endpoint fields deliberately match\n:class:`~drt.config.destinations_storage.S3DestinationConfig`, so state\nstorage follows the same boto3 credential chain and override vocabulary.\nLocal state continues to reject every remote-only field.",
      "properties": {
        "backend": {
          "default": "local",
          "enum": [
            "local",
            "gcs",
            "s3"
          ],
          "title": "Backend",
          "type": "string"
        },
        "bucket": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bucket"
        },
        "prefix": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prefix"
        },
        "region": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Region"
        },
        "aws_profile": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Aws Profile"
        },
        "aws_access_key_id_env": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Aws Access Key Id Env"
        },
        "aws_secret_access_key_env": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Aws Secret Access Key Env"
        },
        "aws_session_token_env": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Aws Session Token Env"
        },
        "endpoint_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Endpoint Url"
        }
      },
      "title": "StateConfig",
      "type": "object"
    }
  },
  "properties": {
    "name": {
      "title": "Name",
      "type": "string"
    },
    "version": {
      "default": "0.1",
      "title": "Version",
      "type": "string"
    },
    "profile": {
      "default": "default",
      "title": "Profile",
      "type": "string"
    },
    "source": {
      "anyOf": [
        {
          "$ref": "#/$defs/SourceConfig"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "history": {
      "$ref": "#/$defs/HistoryConfig"
    },
    "state": {
      "$ref": "#/$defs/StateConfig"
    },
    "vars": {
      "additionalProperties": true,
      "title": "Vars",
      "type": "object"
    },
    "query_tagging": {
      "$ref": "#/$defs/QueryTaggingConfig"
    }
  },
  "required": [
    "name"
  ],
  "title": "ProjectConfig",
  "type": "object",
  "$schema": "http://json-schema.org/draft-07/schema#"
}